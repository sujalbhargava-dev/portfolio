{
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "echo 'skipping root install'",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://portfolio-sujal.onrender.com/api/$1"
    },
    {
      "source": "/([^.]*)",
      "destination": "/index.html"
    }
  ]
}

